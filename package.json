{
  "name": "foxstudio-pro",
  "private": true,
  "version": "42.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "native:configure": "node scripts/configure-native.mjs",
    "native:build": "cmake --build native/build --config Release",
    "native:protocol": "echo \"Native engine uses JSON-lines stdin/stdout; see native/README.md\"",
    "native:check": "cmake --build native/build --config Release --target FoxStudioNative",
    "doctor": "node -e \"console.log(JSON.stringify({node:process.version,platform:process.platform,arch:process.arch},null,2))\"",
    "render:check": "node -e \"console.log(\\\"FOX STUDIO local renderer ready\\\")\"",
    "bundle:validate": "node scripts/validate-project.mjs",
    "native:doctor": "node scripts/native-doctor.mjs",
    "local:build": "npm run build && npm run native:configure && npm run native:build",
    "local:run": "npm run native:doctor && npm run dev"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "native:bootstrap": "bash scripts/bootstrap-native.sh"
}
